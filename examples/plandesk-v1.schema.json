{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "default": "",
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "type": {
          "default": "软件研发",
          "type": "string"
        },
        "owner": {
          "default": "",
          "type": "string"
        },
        "status": {
          "default": "planning",
          "type": "string",
          "enum": [
            "planning",
            "active",
            "completed",
            "archived"
          ]
        },
        "priority": {
          "default": "medium",
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "urgent"
          ]
        },
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "target": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "demo": {
          "default": false,
          "type": "boolean"
        },
        "updatedAt": {
          "default": "",
          "type": "string"
        },
        "createdAt": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "code",
        "description",
        "type",
        "owner",
        "status",
        "priority",
        "start",
        "target",
        "demo",
        "updatedAt",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "calendar": {
      "default": {
        "weekdays": [
          1,
          2,
          3,
          4,
          5
        ],
        "holidays": []
      },
      "type": "object",
      "properties": {
        "weekdays": {
          "default": [
            1,
            2,
            3,
            4,
            5
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "holidays": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      },
      "required": [
        "weekdays",
        "holidays"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "default": [],
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "parentId": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "default": 0,
            "type": "number"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "type": {
            "default": "task",
            "type": "string",
            "enum": [
              "task",
              "phase",
              "milestone",
              "review"
            ]
          },
          "phase": {
            "default": "",
            "type": "string"
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "start": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "end": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "progress": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "status": {
            "default": "todo",
            "type": "string",
            "enum": [
              "todo",
              "doing",
              "blocked",
              "done",
              "cancelled"
            ]
          },
          "owner": {
            "default": "",
            "type": "string"
          },
          "priority": {
            "default": "medium",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ]
          },
          "autoSchedule": {
            "default": true,
            "type": "boolean"
          },
          "estimate": {
            "default": 0,
            "type": "number",
            "minimum": 0
          },
          "actualHours": {
            "default": 0,
            "type": "number",
            "minimum": 0
          },
          "actualStart": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "actualEnd": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "dependencies": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliverables": {
            "default": "",
            "type": "string"
          },
          "acceptanceCriteria": {
            "default": "",
            "type": "string"
          },
          "notes": {
            "default": "",
            "type": "string"
          },
          "risk": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "id",
          "parentId",
          "order",
          "name",
          "description",
          "type",
          "phase",
          "tags",
          "start",
          "end",
          "progress",
          "status",
          "owner",
          "priority",
          "autoSchedule",
          "estimate",
          "actualHours",
          "actualStart",
          "actualEnd",
          "dependencies",
          "deliverables",
          "acceptanceCriteria",
          "notes",
          "risk"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "default": "FS",
            "type": "string",
            "enum": [
              "FS",
              "SS",
              "FF",
              "SF"
            ]
          },
          "lag": {
            "default": 0,
            "type": "integer",
            "minimum": -3650,
            "maximum": 3650
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "type",
          "lag"
        ],
        "additionalProperties": false
      }
    },
    "milestones": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseline": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "start": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "end": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "progress": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "start",
                "end",
                "progress"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "createdAt",
          "tasks"
        ],
        "additionalProperties": false
      }
    },
    "history": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "progress": {
            "type": "number"
          }
        },
        "required": [
          "date",
          "progress"
        ],
        "additionalProperties": false
      }
    },
    "revision": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "calendar",
    "tasks",
    "dependencies",
    "milestones",
    "baseline",
    "history",
    "revision"
  ],
  "additionalProperties": false
}